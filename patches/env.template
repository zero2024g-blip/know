#--------------------------------------------------------------------
# Only the lines that CHANGED or are NEW. Merge these into your .env;
# leave everything else as it is.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# NEW — must match the mode set by tools/set-mode.sh
#--------------------------------------------------------------------
# true  = behind Cloudflare  (CF-Connecting-IP is honoured, but only
#         when the connection really came from a Cloudflare range)
# false = direct, no CDN     (CF-* headers ignored entirely)
#
# Missing / empty / unparseable is treated as FALSE, i.e. the safe side.
app.behindCloudflare = true

#--------------------------------------------------------------------
# CHANGED — was an 8-letter dictionary word
#--------------------------------------------------------------------
# Generate with:  php spark key:generate
# Anything signed or encrypted with the old value was forgeable by
# anyone who guessed it.
encryption.key = hex2bin:PUT_THE_GENERATED_KEY_HERE

#--------------------------------------------------------------------
# CHANGED — was 2592000 (30 days)
#--------------------------------------------------------------------
# How long a stolen session cookie stays useful on a panel that holds
# balance and can revoke every key. 7 days.
app.sessionExpiration = 604800
cookie.expires        = 604800

#--------------------------------------------------------------------
# ROTATE THIS — the old value was in the archive that left your machine
#--------------------------------------------------------------------
# database.default.password = <a new password>

