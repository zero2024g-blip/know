#--------------------------------------------------------------------
# Based on the .env you sent. Only CHANGED / NEW lines are uncommented.
# Everything you already had that was correct is listed as a comment at
# the bottom so you can see it was checked, not missed.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# CHANGED — see DEPLOYMENT-MODES.md "Document root".
# '/public' in the URL means your web root is the PROJECT root, so app/,
# vendor/, writable/ and .env all sit inside the served directory and are
# protected by .htaccess alone. Point the docroot at public/ and use:
# app.baseURL = 'https://panel.zeromods.id/'
app.baseURL = 'https://panel.zeromods.id/public'

app.forceGlobalSecureRequests = true

# CHANGED — was 2592000 (30 days). That is how long a stolen session
# cookie stays useful on a panel holding balance and key control.
app.sessionExpiration = 604800

# LEAVE FALSE. Tying a session to an IP looks safer, but on Iranian
# mobile networks the IP changes constantly and every change would log
# the user out mid-task. The session ID rotating on login is the real
# protection here, and that is already in place.
# app.sessionMatchIP = false

app.CSPEnabled = false

#--------------------------------------------------------------------
# NEW — must agree with tools/set-mode.sh
#--------------------------------------------------------------------
# true  = behind Cloudflare (CF-Connecting-IP honoured, but only when the
#         connection genuinely came from a Cloudflare range)
# false = direct, no CDN    (CF-* headers ignored completely)
#
# Missing, empty or unparseable is read as FALSE — the safe side.
app.behindCloudflare = true

#--------------------------------------------------------------------
# DATABASE — rotate the password, the old one left your machine
#--------------------------------------------------------------------
# database.default.password = <a new password>

#--------------------------------------------------------------------
# COOKIE
#--------------------------------------------------------------------
# CHANGED — was 2592000, matched to the session above.
cookie.expires = 604800

#--------------------------------------------------------------------
# ENCRYPTION — CHANGED
#--------------------------------------------------------------------
# The old value was an 8-letter dictionary word. Anything signed or
# encrypted with it was forgeable by anyone who guessed it.
# With SSH:     php spark key:generate
# Without SSH:  upload tools/genkey.php, open it once, paste the result
#               here, then DELETE genkey.php and .genkey-used.
encryption.key = hex2bin:PUT_THE_GENERATED_KEY_HERE

#--------------------------------------------------------------------
# Already correct in your file. Listed so you know they were reviewed.
#--------------------------------------------------------------------
# cookie.secure   = true          <- cookie never travels over plain HTTP
# cookie.httponly = true          <- JavaScript cannot read the session
# cookie.samesite = 'Strict'      <- blocks cross-site cookie sending
# security.regenerate = true      <- rotates the CSRF hash per request;
#                                    the panel's JS now handles this
# security.samesite = 'Strict'
# honeypot.*                      <- active, with a non-obvious field name
# contentsecuritypolicy.*         <- fully configured but inert while
#                                    app.CSPEnabled is false

#--------------------------------------------------------------------
# APP CONNECTOR — NEW, REQUIRED
#--------------------------------------------------------------------
# The key the Android app and this endpoint share. 64 hex characters.
# Generate one with:  php -r 'echo bin2hex(random_bytes(32)), "\n";'
#
# It used to be a literal inside Controllers/Connect.php, which meant it
# travelled with every copy of the code and could not be rotated without
# a release. If this is missing or malformed the connector answers 503
# and logs 'critical' — it fails closed on purpose.
#
# Changing this REQUIRES rebuilding the app with the same value.
connect.aesKey = PUT_YOUR_64_HEX_KEY_HERE
