diff -ruN /tmp/orig_app/Controllers/BaseController.php app/Controllers/BaseController.php
--- /tmp/orig_app/Controllers/BaseController.php	2026-08-24 23:02:52.529199628 +0000
+++ app/Controllers/BaseController.php	2026-08-26 08:11:56.109693212 +0000
@@ -56,4 +56,91 @@
 		//--------------------------------------------------------------------
 		// E.g.: $this->session = \Config\Services::session();
 	}
+
+    /**
+     * Cloudflare's published edge ranges. Only a request that actually
+     * arrives from one of these is allowed to speak for its client via
+     * CF-Connecting-IP. Refresh from https://www.cloudflare.com/ips/
+     */
+    protected const CF_RANGES = [
+        '173.245.48.0/20', '103.21.244.0/22', '103.22.200.0/22', '103.31.4.0/22',
+        '141.101.64.0/18', '108.162.192.0/18', '190.93.240.0/20', '188.114.96.0/20',
+        '197.234.240.0/22', '198.41.128.0/17', '162.158.0.0/15', '104.16.0.0/13',
+        '104.24.0.0/14', '172.64.0.0/13', '131.0.72.0/22',
+        '2400:cb00::/32', '2606:4700::/32', '2803:f800::/32', '2405:b500::/32',
+        '2405:8100::/32', '2a06:98c0::/29', '2c0f:f248::/32',
+    ];
+
+    protected function clientIp(): string
+    {
+        $remote = (string) $this->request->getIPAddress();
+
+        // MODE B (direct, no CDN): nothing legitimate sets CF-Connecting-IP,
+        // so the header is pure attacker input. Ignore it entirely - the
+        // socket address is the truth. Set app.behindCloudflare = false.
+        //
+        // Default to false: if the setting is missing or misspelled we fall
+        // into the SAFE mode, not the trusting one.
+        $behindCf = filter_var(
+            getenv('app.behindCloudflare') ?: 'false',
+            FILTER_VALIDATE_BOOLEAN
+        );
+
+        if (! $behindCf) {
+            return $remote;
+        }
+
+        // MODE A: the header is only meaningful when the connection really
+        // came from a Cloudflare edge node. Without this check a forged
+        // header makes every request look like a new IP and the login
+        // throttle stops working.
+        if (! $this->fromCloudflare($remote)) {
+            return $remote;
+        }
+
+        $cf = (string) $this->request->getServer('HTTP_CF_CONNECTING_IP');
+
+        return filter_var($cf, FILTER_VALIDATE_IP) ? $cf : $remote;
+    }
+
+    protected function fromCloudflare(string $ip): bool
+    {
+        foreach (self::CF_RANGES as $cidr) {
+            if ($this->ipInCidr($ip, $cidr)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    protected function ipInCidr(string $ip, string $cidr): bool
+    {
+        [$subnet, $bits] = array_pad(explode('/', $cidr, 2), 2, null);
+        $bits = (int) $bits;
+
+        $ipBin     = @inet_pton($ip);
+        $subnetBin = @inet_pton($subnet);
+        if ($ipBin === false || $subnetBin === false) {
+            return false;
+        }
+        // v4 and v6 are different lengths; never compare across families.
+        if (strlen($ipBin) !== strlen($subnetBin)) {
+            return false;
+        }
+
+        $whole = intdiv($bits, 8);
+        $rest  = $bits % 8;
+
+        if ($whole > 0 && strncmp($ipBin, $subnetBin, $whole) !== 0) {
+            return false;
+        }
+        if ($rest === 0) {
+            return true;
+        }
+
+        $mask = chr(0xFF << (8 - $rest) & 0xFF);
+
+        return (($ipBin[$whole] ?? "\0") & $mask) === (($subnetBin[$whole] ?? "\0") & $mask);
+    }
+
 }
diff -ruN /tmp/orig_app/Controllers/Games.php app/Controllers/Games.php
--- /tmp/orig_app/Controllers/Games.php	1970-01-01 00:00:00.000000000 +0000
+++ app/Controllers/Games.php	2026-08-26 14:24:46.899279891 +0000
@@ -0,0 +1,269 @@
+<?php
+
+namespace App\Controllers;
+
+use App\Models\DurationModel;
+use App\Models\GameModel;
+use App\Models\UserModel;
+use Config\Services;
+
+/**
+ * Admin -> Games.
+ *
+ * The catalogue used to be PHP arrays in Controllers/Keys.php, so adding a
+ * game or changing a price meant editing code and re-uploading. This edits
+ * the same thing from the panel.
+ *
+ * Every route here is behind the `admin` filter (see Config/Routes.php), and
+ * each action re-checks the level itself rather than trusting that — a route
+ * can be moved out of the group by accident, a method cannot lose its own
+ * guard as quietly.
+ */
+class Games extends BaseController
+{
+    protected $games, $durations, $user;
+
+    public function __construct()
+    {
+        $this->games     = new GameModel();
+        $this->durations = new DurationModel();
+        $this->user      = (new UserModel())->getUser();
+    }
+
+    /** Refuse anyone who is not an admin, whatever the routing says. */
+    private function denyNonAdmin()
+    {
+        if (! $this->user || (int) $this->user->level !== 1) {
+            return redirect()->to('dashboard')->with('msgWarning', 'Access Denied!');
+        }
+        return null;
+    }
+
+    public function index()
+    {
+        if ($stop = $this->denyNonAdmin()) {
+            return $stop;
+        }
+
+        $games = $this->games->allOrdered();
+        $tiers = [];
+        foreach ($games as $g) {
+            $tiers[$g->id_game] = $this->durations->forGame((int) $g->id_game, false);
+        }
+
+        return view('Admin/games', [
+            'title'      => 'Games',
+            'user'       => $this->user,
+            'time'       => $this->time ?? new \CodeIgniter\I18n\Time(),
+            'games'      => $games,
+            'tiers'      => $tiers,
+            'keyCounts'  => array_combine(
+                array_map(static fn ($g) => $g->id_game, $games),
+                array_map(fn ($g) => $this->games->keyCount($g->code), $games)
+            ),
+            'validation' => Services::validation(),
+        ]);
+    }
+
+    // -----------------------------------------------------------------
+    //  Games
+    // -----------------------------------------------------------------
+
+    public function saveGame()
+    {
+        if ($stop = $this->denyNonAdmin()) {
+            return $stop;
+        }
+
+        $id   = (int) $this->request->getPost('id_game');
+        $code = strtoupper(trim((string) $this->request->getPost('code')));
+
+        // The code is embedded in every key string this game has produced
+        // (CODM_a1b2c3...), so it is fixed once keys exist. The name is not.
+        $existing = $id ? $this->games->find($id) : null;
+        $locked   = $existing && $this->games->keyCount($existing->code) > 0;
+        if ($locked) {
+            $code = $existing->code;
+        }
+
+        $unique = $id ? "is_unique[games.code,id_game,{$id}]" : 'is_unique[games.code]';
+
+        $rules = [
+            'code' => [
+                'label' => 'code',
+                'rules' => "required|alpha_numeric|min_length[2]|max_length[32]|{$unique}",
+                'errors' => [
+                    'alpha_numeric' => 'The code may only contain letters and numbers.',
+                    'is_unique'     => 'Another game already uses that code.',
+                ],
+            ],
+            'name' => [
+                'label' => 'name',
+                'rules' => 'required|max_length[96]',
+            ],
+            'status'     => ['label' => 'status', 'rules' => 'required|in_list[0,1]'],
+            'sort_order' => ['label' => 'order',  'rules' => 'permit_empty|integer|greater_than_equal_to[0]|less_than_equal_to[9999]'],
+        ];
+
+        // Validate the code we will actually store, not the posted one, or a
+        // locked game would fail is_unique against itself.
+        //
+        // The validation service rather than $this->validate(): that reads
+        // straight from the request, and validateData() - which takes an
+        // array - only exists from CodeIgniter 4.2.
+        $post = $this->request->getPost();
+        $post['code'] = $code;
+
+        $validation = Services::validation();
+        if (! $validation->setRules($rules)->run($post)) {
+            return redirect()->to('admin/games')->withInput()
+                ->with('msgDanger', 'Could not save the game: '
+                    . implode(' ', $validation->getErrors()));
+        }
+
+        $data = [
+            'code'       => $code,
+            'name'       => trim((string) $this->request->getPost('name')),
+            'status'     => (int) $this->request->getPost('status'),
+            'sort_order' => (int) ($this->request->getPost('sort_order') ?: 0),
+        ];
+
+        if ($id && $existing) {
+            $this->games->update($id, $data);
+            $msg = 'Game updated.';
+        } else {
+            $this->games->insert($data);
+            $msg = 'Game added.';
+        }
+
+        return redirect()->to('admin/games')->with('msgSuccess', $msg);
+    }
+
+    public function deleteGame()
+    {
+        if ($stop = $this->denyNonAdmin()) {
+            return $stop;
+        }
+
+        $id   = (int) $this->request->getPost('id_game');
+        $game = $id ? $this->games->find($id) : null;
+        if (! $game) {
+            return redirect()->to('admin/games')->with('msgDanger', 'That game no longer exists.');
+        }
+
+        // Keys carry the game code and are read back by it. Deleting a game
+        // that keys point at would leave them unreadable, so this refuses and
+        // offers the reversible alternative instead.
+        $keys = $this->games->keyCount($game->code);
+        if ($keys > 0) {
+            return redirect()->to('admin/games')->with(
+                'msgWarning',
+                "{$game->name} has {$keys} key(s) against it and cannot be deleted. "
+                . 'Set it to Inactive instead — existing keys keep working and no new ones can be made.'
+            );
+        }
+
+        $this->games->delete($id);   // durations cascade
+
+        return redirect()->to('admin/games')->with('msgSuccess', 'Game deleted.');
+    }
+
+    // -----------------------------------------------------------------
+    //  Durations
+    // -----------------------------------------------------------------
+
+    public function saveDuration()
+    {
+        if ($stop = $this->denyNonAdmin()) {
+            return $stop;
+        }
+
+        $id     = (int) $this->request->getPost('id_duration');
+        $gameId = (int) $this->request->getPost('game_id');
+
+        if (! $this->games->find($gameId)) {
+            return redirect()->to('admin/games')->with('msgDanger', 'That game no longer exists.');
+        }
+
+        $rules = [
+            'hours' => [
+                'label' => 'hours',
+                'rules' => 'required|integer|greater_than_equal_to[1]|less_than_equal_to[87600]',
+                'errors' => [
+                    'less_than_equal_to' => 'Ten years is the longest tier allowed.',
+                ],
+            ],
+            'label' => ['label' => 'label', 'rules' => 'required|max_length[64]'],
+            'price' => [
+                'label' => 'price',
+                'rules' => 'required|decimal|greater_than_equal_to[0]|less_than_equal_to[100000]',
+                'errors' => [
+                    'greater_than_equal_to' => 'A price cannot be negative.',
+                ],
+            ],
+            'admin_only' => ['label' => 'admin only', 'rules' => 'required|in_list[0,1]'],
+            'status'     => ['label' => 'status',     'rules' => 'required|in_list[0,1]'],
+            'sort_order' => ['label' => 'order',      'rules' => 'permit_empty|integer|greater_than_equal_to[0]|less_than_equal_to[9999]'],
+        ];
+
+        $validation = Services::validation();
+        if (! $validation->setRules($rules)->run($this->request->getPost())) {
+            return redirect()->to('admin/games')->withInput()
+                ->with('msgDanger', 'Could not save the tier: '
+                    . implode(' ', $validation->getErrors()));
+        }
+
+        $hours = (int) $this->request->getPost('hours');
+
+        // One tier per game per duration: two "30 days" rows at different
+        // prices would make the price depend on row order.
+        $clash = $this->durations
+            ->where('game_id', $gameId)
+            ->where('hours', $hours)
+            ->where('id_duration !=', $id ?: 0)
+            ->first();
+        if ($clash) {
+            return redirect()->to('admin/games')->withInput()
+                ->with('msgDanger', 'That game already has a tier of ' . $hours . ' hours.');
+        }
+
+        $data = [
+            'game_id'    => $gameId,
+            'hours'      => $hours,
+            'label'      => trim((string) $this->request->getPost('label')),
+            'price'      => (float) $this->request->getPost('price'),
+            'admin_only' => (int) $this->request->getPost('admin_only'),
+            'status'     => (int) $this->request->getPost('status'),
+            'sort_order' => (int) ($this->request->getPost('sort_order') ?: 0),
+        ];
+
+        if ($id && $this->durations->find($id)) {
+            $this->durations->update($id, $data);
+            $msg = 'Tier updated.';
+        } else {
+            $this->durations->insert($data);
+            $msg = 'Tier added.';
+        }
+
+        return redirect()->to('admin/games')->with('msgSuccess', $msg);
+    }
+
+    public function deleteDuration()
+    {
+        if ($stop = $this->denyNonAdmin()) {
+            return $stop;
+        }
+
+        $id = (int) $this->request->getPost('id_duration');
+        if (! $id || ! $this->durations->find($id)) {
+            return redirect()->to('admin/games')->with('msgDanger', 'That tier no longer exists.');
+        }
+
+        // Safe to delete outright: keys store the hours they were sold with,
+        // not a reference to this row, so removing a tier only stops new
+        // sales. Existing keys are untouched.
+        $this->durations->delete($id);
+
+        return redirect()->to('admin/games')->with('msgSuccess', 'Tier removed.');
+    }
+}
