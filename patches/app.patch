+<?php
+
+namespace App\Models;
+
+use CodeIgniter\Model;
+
+/**
+ * The archive of deleted keys.
+ *
+ * Deleting a key moves it here rather than erasing it, so the record of what
+ * was sold survives the deletion. `history` rows are left exactly where they
+ * are and still point at the key by id.
+ */
+class DeletedKeyModel extends Model
+{
+    protected $table      = 'keys_deleted';
+    protected $primaryKey = 'id_deleted';
+
+    protected $allowedFields = [
+        'id_keys', 'game', 'user_key', 'duration', 'expired_date', 'max_devices',
+        'devices', 'status', 'registrator', 'key_created', 'deleted_by', 'reason',
+    ];
+    protected $useTimestamps = true;
+    protected $returnType    = 'object';
+
+    /** How many keys this admin has deleted inside the window. */
+    public function recentCountBy(string $admin, int $windowHours): int
+    {
+        return $this->where('deleted_by', $admin)
+            ->where('created_at >=', date('Y-m-d H:i:s', time() - $windowHours * 3600))
+            ->countAllResults();
+    }
+
+    /** The archive, newest first. */
+    public function recent(int $limit = 100): array
+    {
+        return $this->orderBy('id_deleted', 'DESC')->findAll($limit);
+    }
+}
