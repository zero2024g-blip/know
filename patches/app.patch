diff -ruN /tmp/orig_app/Models/LoginSessionModel.php app/Models/LoginSessionModel.php
--- /tmp/orig_app/Models/LoginSessionModel.php	1970-01-01 00:00:00.000000000 +0000
+++ app/Models/LoginSessionModel.php	2026-08-27 00:07:50.692213641 +0000
@@ -0,0 +1,233 @@
+<?php
+
+namespace App\Models;
+
+use CodeIgniter\Model;
+
+/**
+ * Sign-in history, and the fingerprint that stops a stolen session cookie.
+ *
+ * A session cookie is a bearer token: whoever holds it is treated as the
+ * person it was issued to. Copying one out of a browser and pasting it into
+ * another is exactly the attack described as "they copy a bit of the cookie
+ * and the panel believes they are that person".
+ *
+ * The defence is to stop treating the cookie as sufficient on its own. Each
+ * session is bound to a fingerprint of the browser that created it, and the
+ * fingerprint is checked on every request. The cookie alone no longer gets
+ * you in — you would also have to reproduce the browser it was minted in,
+ * and do it before the session expires.
+ */
+class LoginSessionModel extends Model
+{
+    protected $table      = 'login_sessions';
+    protected $primaryKey = 'id_session';
+
+    protected $allowedFields = [
+        'user_id', 'username', 'session_id', 'fingerprint', 'ip_hash',
+        'user_agent', 'device', 'login_at', 'last_seen_at', 'logout_at', 'end_reason',
+    ];
+    protected $useTimestamps = true;
+    protected $returnType    = 'object';
+
+    /**
+     * Fingerprint for the current request.
+     *
+     * Deliberately built from things that do not change while a person keeps
+     * using the same browser:
+     *
+     *   - the user agent, which is stable per browser build
+     *   - a server secret, so the value cannot be computed by an attacker
+     *     who knows the user agent
+     *
+     * The IP is NOT in here on purpose. On Iranian mobile networks it changes
+     * constantly, and binding to it would log people out every few minutes —
+     * a protection nobody can live with gets switched off, which protects
+     * nothing. The IP is still recorded, just not used to decide.
+     */
+    public static function fingerprint(?string $userAgent = null): string
+    {
+        $ua     = $userAgent ?? ($_SERVER['HTTP_USER_AGENT'] ?? '');
+        $secret = (string) (env('encryption.key') ?: config('App')->baseURL);
+
+        return hash_hmac('sha256', $ua, $secret);
+    }
+
+    /**
+     * The current session id.
+     *
+     * CodeIgniter's Session class has no session_id() method - it drives PHP's
+     * native session handling, so the id comes from PHP's own function. Calling
+     * it through the framework object looked right and threw, which took the
+     * whole protection out silently: every call site caught the error, logged
+     * it and carried on.
+     */
+    public static function currentId(): string
+    {
+        return (string) \session_id();
+    }
+
+    /** The session id is stored hashed, so this table is not a set of keys. */
+    public static function hashSessionId(string $sessionId): string
+    {
+        return hash('sha256', $sessionId);
+    }
+
+    /**
+     * A readable device name from a user agent.
+     *
+     * Best effort and deliberately coarse. It is here so a person can
+     * recognise their own sign-ins at a glance; the full user agent is kept
+     * alongside it for when the detail matters.
+     */
+    public static function describe(?string $ua): string
+    {
+        $ua = (string) $ua;
+        if ($ua === '') {
+            return 'Unknown device';
+        }
+
+        $os = 'Unknown OS';
+        foreach ([
+            '/Windows NT 10\.0/i'      => 'Windows 10/11',
+            '/Windows NT 6\.3/i'       => 'Windows 8.1',
+            '/Windows NT 6\.1/i'       => 'Windows 7',
+            '/Android ([\d.]+)/i'      => 'Android %s',
+            '/iPhone OS ([\d_]+)/i'    => 'iOS %s',
+            '/iPad.*OS ([\d_]+)/i'     => 'iPadOS %s',
+            '/Mac OS X ([\d_]+)/i'     => 'macOS %s',
+            '/CrOS/i'                  => 'ChromeOS',
+            '/Ubuntu/i'                => 'Ubuntu',
+            '/Linux/i'                 => 'Linux',
+        ] as $re => $name) {
+            if (preg_match($re, $ua, $m)) {
+                $os = str_contains($name, '%s')
+                    ? sprintf($name, str_replace('_', '.', $m[1]))
+                    : $name;
+                break;
+            }
+        }
+
+        $browser = 'Unknown browser';
+        // Order matters: Edge and Opera both claim to be Chrome, and Chrome
+        // claims to be Safari, so the most specific has to be tested first.
+        foreach ([
+            '/Edg\/([\d.]+)/i'      => 'Edge',
+            '/OPR\/([\d.]+)/i'      => 'Opera',
+            '/SamsungBrowser/i'     => 'Samsung Internet',
+            '/Firefox\/([\d.]+)/i'  => 'Firefox',
+            '/Chrome\/([\d.]+)/i'   => 'Chrome',
+            '/Version\/([\d.]+).*Safari/i' => 'Safari',
+            '/curl\//i'             => 'curl',
+        ] as $re => $name) {
+            if (preg_match($re, $ua)) {
+                $browser = $name;
+                break;
+            }
+        }
+
+        return $browser . ' · ' . $os;
+    }
+
+    /** Record a sign-in. Returns the row id. */
+    public function begin(object $user, string $sessionId, string $ipHash): int
+    {
+        $ua = mb_substr((string) ($_SERVER['HTTP_USER_AGENT'] ?? ''), 0, 255);
+
+        return (int) $this->insert([
+            'user_id'      => (int) $user->id_users,
+            'username'     => $user->username,
+            'session_id'   => self::hashSessionId($sessionId),
+            'fingerprint'  => self::fingerprint($ua),
+            'ip_hash'      => $ipHash,
+            'user_agent'   => $ua,
+            'device'       => self::describe($ua),
+            'login_at'     => date('Y-m-d H:i:s'),
+            'last_seen_at' => date('Y-m-d H:i:s'),
+        ]);
+    }
+
+    /** Close a session. $reason says how it ended. */
+    public function end(string $sessionId, string $reason = 'logout'): void
+    {
+        $this->where('session_id', self::hashSessionId($sessionId))
+             ->where('logout_at', null)
+             ->set([
+                 'logout_at'  => date('Y-m-d H:i:s'),
+                 'end_reason' => $reason,
+                 'updated_at' => date('Y-m-d H:i:s'),
+             ])
+             ->update();
+    }
+
+    /** Keep "last seen" roughly current without a write on every request. */
+    public function touch(string $sessionId): void
+    {
+        $this->where('session_id', self::hashSessionId($sessionId))
+             ->where('logout_at', null)
+             ->where('last_seen_at <', date('Y-m-d H:i:s', time() - 60))
+             ->set(['last_seen_at' => date('Y-m-d H:i:s')])
+             ->update();
+    }
+
+    /**
+     * The open session for this id, or null.
+     *
+     * Used by the filter to compare fingerprints, so it reads the stored
+     * value rather than trusting anything in the request.
+     */
+    public function openSession(string $sessionId): ?object
+    {
+        return $this->where('session_id', self::hashSessionId($sessionId))
+                    ->where('logout_at', null)
+                    ->first();
+    }
+
+    /** Page sizes the settings page offers, smallest first. */
+    public const PAGE_SIZES = [25, 50, 100, 200];
+
+    /**
+     * Restrict a query to what this viewer is allowed to see.
+     *
+     * An admin asking for everyone's gets no restriction; anyone else — and
+     * an admin looking at their own list — is pinned to their own rows. The
+     * scoping is here rather than in the controller or the view, so a caller
+     * cannot widen it by passing the wrong flag.
+     */
+    private function scopeTo(object $viewer, bool $all): void
+    {
+        $isAdmin = (int) $viewer->level === 1;
+
+        if (! ($all && $isAdmin)) {
+            $this->where('user_id', (int) $viewer->id_users);
+        }
+    }
+
+    /**
+     * Sign-ins to show on the settings page.
+     *
+     * $viewer is whose list this is. An admin passing $all sees every
+     * account's, with the username on each row; a seller only ever gets
+     * their own.
+     */
+    public function historyFor(object $viewer, bool $all = false, int $limit = 60, int $offset = 0): array
+    {
+        $this->scopeTo($viewer, $all);
+
+        return $this->orderBy('id_session', 'DESC')->findAll($limit, $offset);
+    }
+
+    /**
+     * How many rows that same list holds.
+     *
+     * Kept separate from historyFor() rather than counting what it returned:
+     * the page only ever loads one page of rows, so the total has to come
+     * from the database.
+     */
+    public function countFor(object $viewer, bool $all = false): int
+    {
+        $this->scopeTo($viewer, $all);
+
+        return $this->countAllResults();
+    }
+}
