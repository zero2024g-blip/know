+/**
+ * One row of the sign-in list.
+ *
+ * $showUser adds the account name — the admin table needs it, your own list
+ * does not, and repeating your own username on forty rows is just noise.
+ */
+$signInRow = static function (object $r, bool $showUser, bool $isCurrent) {
+    $open  = $r->logout_at === null;
+    // "Open" only counts while the session could still be in use. A row left
+    // open by a browser that was simply closed is not someone signed in.
+    $stale = $open && strtotime((string) ($r->last_seen_at ?: $r->login_at)) < time() - 7200;
+    ?>
+    <tr<?= $isCurrent ? ' class="em-sess-current"' : '' ?>>
+        <?php if ($showUser) : ?>
+            <td>
+                <b><?= esc($r->username) ?></b>
+                <?php if ($isCurrent) : ?><span class="em-pill is-accent">you</span><?php endif; ?>
+            </td>
+        <?php endif; ?>
+        <td>
+            <b><?= esc($r->device ?: 'Unknown device') ?></b>
+            <?php if (! $showUser && $isCurrent) : ?>
+                <span class="em-pill is-accent">this device</span>
+            <?php endif; ?>
+            <small class="em-ua" title="<?= esc($r->user_agent ?? '') ?>"><?= esc($r->user_agent ?: '—') ?></small>
+        </td>
+        <td class="em-sess-time">
+            <b><?= esc(date('H:i:s', strtotime((string) $r->login_at))) ?></b>
+            <small><?= esc(date('D j M', strtotime((string) $r->login_at))) ?></small>
+        </td>
+        <td class="em-sess-time em-sess-out">
+            <?php if ($open) : ?>
+                <span class="text-muted">—</span>
+                <small>last seen <?= esc(date('H:i:s', strtotime((string) ($r->last_seen_at ?: $r->login_at)))) ?></small>
+            <?php else : ?>
+                <b><?= esc(date('H:i:s', strtotime((string) $r->logout_at))) ?></b>
+                <small><?= esc(date('D j M', strtotime((string) $r->logout_at))) ?></small>
+            <?php endif; ?>
+        </td>
+        <td class="text-end">
+            <?php if ($open && ! $stale) : ?>
+                <span class="em-pill is-ok"><span class="em-dot"></span>Signed in</span>
+            <?php elseif ($open) : ?>
+                <span class="em-pill is-warn">Left open</span>
+            <?php elseif ($r->end_reason === 'fingerprint') : ?>
+                <!-- The session was destroyed because the cookie turned up in
+                     a different browser. Worth calling out by name: this is
+                     the one row on the page that means someone tried. -->
+                <span class="em-pill is-bad"><i class="bi bi-shield-exclamation"></i> Blocked</span>
+            <?php else : ?>
+                <span class="em-pill">Signed out</span>
+            <?php endif; ?>
+        </td>
+    </tr>
+    <?php
+};
