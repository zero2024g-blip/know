+<?php
+
+namespace App\Models;
+
+use CodeIgniter\Model;
+
+/**
+ * The balance ledger.
+ *
+ * Append-only: rows are written when money moves and never edited after.
+ * `users.saldo` stays the working figure; this explains how it got there.
+ */
+class BalanceModel extends Model
+{
+    protected $table      = 'balance_log';
+    protected $primaryKey = 'id_log';
+
+    protected $allowedFields = ['user_id', 'delta', 'balance_after', 'reason', 'actor', 'note'];
+    protected $useTimestamps = true;
+    protected $returnType    = 'object';
+
+    public const TOPUP    = 'topup';
+    public const ADJUST   = 'adjustment';
+    public const PURCHASE = 'key_purchase';
+    public const REFERRAL = 'referral_signup';
+    public const OPENING  = 'opening';
+
+    /**
+     * Record one movement.
+     *
+     * Call inside the same transaction as the balance change itself, so the
+     * two either both land or neither does. A ledger that can disagree with
+     * the balance it describes is worse than no ledger.
+     *
+     * $balanceAfter is passed in rather than read back here: reading it would
+     * be a second query against a row another request may already have moved.
+     */
+    public function record(
+        int $userId,
+        float $delta,
+        float $balanceAfter,
+        string $reason,
+        ?string $actor = null,
+        ?string $note = null
+    ): void {
+        $this->insert([
+            'user_id'       => $userId,
+            'delta'         => $delta,
+            'balance_after' => $balanceAfter,
+            'reason'        => $reason,
+            'actor'         => $actor,
+            'note'          => $note !== null ? mb_substr($note, 0, 255) : null,
+        ]);
+    }
+
+    /** Most recent movements for one account. */
+    public function history(int $userId, int $limit = 50): array
+    {
+        return $this->where('user_id', $userId)
+            ->orderBy('id_log', 'DESC')
+            ->findAll($limit);
+    }
+
+    /**
+     * Totals for the account page.
+     *
+     * Credits and debits are summed separately rather than netted, because
+     * "you were topped up 400 and spent 250" says more than "net 150".
+     */
+    public function summary(int $userId): array
+    {
+        $row = $this->db->table($this->table)
+            ->select("
+                COALESCE(SUM(CASE WHEN delta > 0 AND reason <> 'opening' THEN delta END), 0) AS credited,
+                COALESCE(SUM(CASE WHEN reason = 'key_purchase' THEN -delta END), 0)          AS spent,
+                COALESCE(SUM(CASE WHEN reason = 'adjustment' THEN -delta END), 0)            AS deducted,
+                COALESCE(SUM(CASE WHEN reason = 'topup' THEN delta END), 0)                  AS topped_up,
+                COALESCE(SUM(CASE WHEN reason = 'topup' THEN 1 END), 0)                      AS topup_count,
+                MAX(CASE WHEN reason = 'topup' THEN created_at END)                          AS last_topup
+            ", false)
+            ->where('user_id', $userId)
+            ->get()->getRowObject();
+
+        return [
+            'credited'    => (float) ($row->credited ?? 0),
+            // Only real purchases. Summing every negative movement would fold
+            // an admin's manual reduction into "spent on keys", which is a
+            // different thing and made the figure read high.
+            'spent'       => (float) ($row->spent ?? 0),
+            'deducted'    => (float) ($row->deducted ?? 0),
+            'topped_up'   => (float) ($row->topped_up ?? 0),
+            'topup_count' => (int)   ($row->topup_count ?? 0),
+            'last_topup'  => $row->last_topup ?? null,
+        ];
+    }
+
+    /** Who has topped this account up, and how much in total. */
+    public function topUpSources(int $userId): array
+    {
+        return $this->db->table($this->table)
+            ->select('actor, COUNT(*) AS times, SUM(delta) AS total, MAX(created_at) AS last_at', false)
+            ->where('user_id', $userId)
+            ->where('reason', self::TOPUP)
+            ->groupBy('actor')
+            ->orderBy('total', 'DESC')
+            ->get()->getResultObject();
+    }
+}
