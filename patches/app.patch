+    /**
+     * Delete a key. Admins only.
+     *
+     * The row is archived to keys_deleted first, so the record of what was
+     * sold survives; `history` is untouched and still refers to the key by id.
+     *
+     * Deletions are rate limited per admin. The point is not to inconvenience
+     * you — it is that an admin account which gets taken over cannot empty the
+     * table in one go and disappear. A real admin clearing out a handful of
+     * test keys never reaches the limit; a script trying to wipe thousands
+     * hits it within seconds, and the archive still holds everything it
+     * managed to remove.
+     */
+    public function delete_key()
+    {
+        $user = $this->user;
+
+        // Re-checked here rather than trusting the route group alone: a route
+        // can be moved by accident, a method's own guard cannot.
+        if (! $user || (int) $user->level !== 1) {
+            return $this->response->setStatusCode(403)
+                ->setJSON(['ok' => false, 'error' => 'Access denied.']);
+        }
+
+        // Scalars only: an array posted as id_keys[] casts with a warning,
+        // which the error handler turns into a 500.
+        $postedId = $this->request->getPost('id_keys');
+        $id       = is_scalar($postedId) ? (int) $postedId : 0;
+        if ($id < 1) {
+            return $this->response->setJSON(['ok' => false, 'error' => 'No key given.']);
+        }
+
+        $archive = new \App\Models\DeletedKeyModel();
+
+        try {
+            $used = $archive->recentCountBy($user->username, self::DELETE_WINDOW_HOURS);
+        } catch (\Throwable $e) {
+            // Fail CLOSED. If the counter cannot be read there is no limit,
+            // and an unlimited delete is exactly what this guards against.
+            log_message('critical', 'Delete limit unreadable: {msg}', ['msg' => $e->getMessage()]);
+            return $this->response->setJSON([
+                'ok' => false, 'error' => 'Deletion is unavailable right now.',
+            ]);
+        }
+
+        if ($used >= self::DELETE_LIMIT) {
+            return $this->response->setJSON([
+                'ok'    => false,
+                'error' => sprintf(
+                    'Limit reached: %d keys in %d hours. Try again later.',
+                    self::DELETE_LIMIT,
+                    self::DELETE_WINDOW_HOURS
+                ),
+            ]);
+        }
+
+        // getKeys(), not find(): KeysModel does not set $returnType, so find()
+        // hands back an array and every ->property read below is a fatal.
+        $key = $this->model->getKeys($id, 'id_keys');
+        if (! $key) {
+            return $this->response->setJSON(['ok' => false, 'error' => 'That key no longer exists.']);
+        }
+
+        $db = \Config\Database::connect();
+        $db->transBegin();
+
+        try {
+            $archive->insert([
+                'id_keys'      => (int) $key->id_keys,
+                'game'         => $key->game,
+                'user_key'     => $key->user_key,
+                'duration'     => $key->duration,
+                'expired_date' => $key->expired_date,
+                'max_devices'  => $key->max_devices,
+                'devices'      => $key->devices,
+                'status'       => $key->status,
+                'registrator'  => $key->registrator,
+                'key_created'  => $key->created_at,
+                'deleted_by'   => $user->username,
+                'reason'       => $this->postedReason(),
+            ]);
+
+            // Archive first, delete second. If the archive write fails the
+            // whole thing rolls back and the key stays — losing the key and
+            // its record together is the one outcome to avoid.
+            $this->model->delete($id);
+
+            if ($db->transStatus() === false) {
+                throw new \RuntimeException('delete transaction failed');
+            }
+            $db->transCommit();
+        } catch (\Throwable $e) {
+            $db->transRollback();
+            log_message('error', 'Key delete failed: {msg}', ['msg' => $e->getMessage()]);
+            return $this->response->setJSON(['ok' => false, 'error' => 'Could not delete. Nothing was changed.']);
+        }
+
+        return $this->response->setJSON([
+            'ok'        => true,
+            'remaining' => max(0, self::DELETE_LIMIT - ($used + 1)),
+            'csrf'      => csrf_hash(),
+        ]);
+    }
+
+    /** The optional free-text reason on a delete, trimmed and bounded. */
+    private function postedReason(): ?string
+    {
+        $reason = $this->request->getPost('reason');
+        if (! is_scalar($reason)) {
+            return null;
+        }
+
+        return mb_substr(trim((string) $reason), 0, 255) ?: null;
+    }
