--- /tmp/orig_app/Models/SettingModel.php	1970-01-01 00:00:00.000000000 +0000
+++ app/Models/SettingModel.php	2026-08-27 23:04:28.810542550 +0000
@@ -0,0 +1,251 @@
+<?php
+
+namespace App\Models;
+
+use CodeIgniter\Model;
+
+/**
+ * Panel settings that an admin can change without editing a file.
+ *
+ * One row per setting, keyed by name. Deliberately a table rather than a
+ * config file: shared hosting has no way to edit PHP safely from a phone,
+ * and a value that lives in source cannot be changed without a re-upload.
+ */
+class SettingModel extends Model
+{
+    protected $table         = 'settings';
+    protected $primaryKey    = 'name';
+    protected $allowedFields = ['name', 'value', 'updated_by'];
+    protected $useTimestamps = true;
+    protected $returnType    = 'object';
+    protected $useAutoIncrement = false;
+
+    public const MAINTENANCE     = 'connector.maintenance';
+    public const MAINTENANCE_MSG = 'connector.maintenance_message';
+
+    /** When the current maintenance began, as a unix timestamp. Empty when off. */
+    public const MAINTENANCE_SINCE = 'connector.maintenance_since';
+
+    /** What the last turn-off gave back: "unixtime|seconds|keys". */
+    public const MAINTENANCE_CREDIT = 'connector.maintenance_credit';
+
+    public const DEFAULT_MESSAGE = 'Server is under Maintenance.';
+
+    /**
+     * The most downtime that will ever be handed back in one go: 30 days.
+     *
+     * A switch left on by accident, or a clock that jumped, must not push
+     * every key in the table years into the future. Anything longer is
+     * credited as 30 days and said plainly in the log.
+     */
+    public const MAX_CREDIT_SECONDS = 30 * 24 * 3600;
+
+    /**
+     * Read once per request.
+     *
+     * The connector is hit on every key check, and without this a page that
+     * asks twice pays for two queries. Scoped to the request, so a change
+     * made in the panel takes effect on the very next request rather than
+     * whenever a cache decides to expire.
+     */
+    private static array $cache = [];
+
+    /** A setting's value, or $default if it is unset or unreadable. */
+    public static function get(string $name, $default = null)
+    {
+        if (array_key_exists($name, self::$cache)) {
+            return self::$cache[$name];
+        }
+
+        try {
+            $row = (new self())->where('name', $name)->first();
+            $value = $row->value ?? $default;
+        } catch (\Throwable $e) {
+            // Never take the panel or the connector down over a settings
+            // read. Say so loudly, then carry on with the default.
+            log_message('critical',
+                'settings unavailable ({msg}); using the default for {name}.',
+                ['msg' => $e->getMessage(), 'name' => $name]);
+            $value = $default;
+        }
+
+        return self::$cache[$name] = $value;
+    }
+
+    /** Write a setting. Returns true if it landed. */
+    public function put(string $name, string $value, ?string $actor = null): bool
+    {
+        unset(self::$cache[$name]);
+
+        // One statement, so two admins saving at the same moment cannot
+        // produce a duplicate-key error instead of a last-writer-wins.
+        return (bool) $this->db->query(
+            'INSERT INTO settings (name, value, updated_by, created_at, updated_at)
+             VALUES (?, ?, ?, NOW(), NOW())
+             ON DUPLICATE KEY UPDATE value = VALUES(value),
+                                     updated_by = VALUES(updated_by),
+                                     updated_at = NOW()',
+            [$name, $value, $actor]
+        );
+    }
+
+    /**
+     * Is the app connector in maintenance?
+     *
+     * This is the one your own Connect.php calls. Replace
+     *
+     *     $this->maintenance = false;
+     *
+     * with
+     *
+     *     $this->maintenance = \App\Models\SettingModel::maintenance();
+     *
+     * and the switch in Admin -> Maintenance drives it.
+     *
+     * Fails OPEN on purpose: if the settings table cannot be read, apps keep
+     * working. A database hiccup must not look like a deliberate shutdown.
+     */
+    public static function maintenance(): bool
+    {
+        return self::get(self::MAINTENANCE, '0') === '1';
+    }
+
+    /** The message apps are shown while maintenance is on. */
+    public static function maintenanceMessage(): string
+    {
+        $msg = trim((string) self::get(self::MAINTENANCE_MSG, ''));
+
+        return $msg !== '' ? $msg : self::DEFAULT_MESSAGE;
+    }
+
+    /**
+     * Give the maintenance downtime back to every key that was still running.
+     *
+     * Keys hold an absolute expiry, so a key's clock keeps going while the
+     * apps are refused. Turning maintenance off shifts every unexpired key
+     * forward by exactly how long it was on -- which is what "the clock was
+     * paused" means, and leaves each key with the same time remaining it had
+     * when the switch was thrown.
+     *
+     * Deliberately untouched:
+     *   - keys that had already expired before maintenance began. They were
+     *     not running, so there is nothing to give back.
+     *   - keys never activated (expired_date IS NULL). Their clock has not
+     *     started, so they lost nothing.
+     *
+     * Runs in one transaction, and the "since" marker is taken with
+     * FOR UPDATE and cleared inside it. Two admins turning the switch off at
+     * the same moment cannot both credit the same downtime.
+     *
+     * @return array{seconds:int,keys:int,clamped:bool}|null
+     *         null when there is nothing to credit.
+     */
+    public function creditDowntime(?string $actor = null): ?array
+    {
+        $db = \Config\Database::connect();
+        $db->transBegin();
+
+        try {
+            $row = $db->query(
+                'SELECT value FROM settings WHERE name = ? FOR UPDATE',
+                [self::MAINTENANCE_SINCE]
+            )->getRowObject();
+
+            $since = (int) ($row->value ?? 0);
+            $now   = time();
+
+            // No marker, or a clock that ran backwards: nothing to give back.
+            if ($since <= 0 || $since >= $now) {
+                $db->transRollback();
+
+                return null;
+            }
+
+            $seconds = $now - $since;
+            $clamped = $seconds > self::MAX_CREDIT_SECONDS;
+
+            if ($clamped) {
+                log_message('warning',
+                    'Maintenance ran for {real}s, longer than the {cap}s cap; crediting the cap.',
+                    ['real' => $seconds, 'cap' => self::MAX_CREDIT_SECONDS]);
+                $seconds = self::MAX_CREDIT_SECONDS;
+            }
+
+            // The boundary must be in the SAME clock as expired_date, or the
+            // wrong keys get credited. expired_date is written by the app in
+            // its own timezone (Config\App::$appTimezone); FROM_UNIXTIME()
+            // would instead render in MySQL's session timezone, and on a
+            // server where those differ (app Asia/Tehran, MySQL UTC) the
+            // boundary is off by the offset -- reviving keys that had already
+            // died hours before maintenance began. So the boundary is built
+            // here as an app-timezone wall-clock string and passed as a plain
+            // value. DATE_ADD works on the stored string and is timezone
+            // agnostic, so the credit amount is unaffected.
+            $tz       = config(\Config\App::class)->appTimezone ?: date_default_timezone_get();
+            $boundary = \CodeIgniter\I18n\Time::createFromTimestamp($since, $tz)->toDateTimeString();
+
+            // Clear the marker first, inside the same transaction: if the
+            // update below fails, the rollback puts the marker back too.
+            $db->query('UPDATE settings SET value = ?, updated_at = NOW() WHERE name = ?',
+                ['', self::MAINTENANCE_SINCE]);
+
+            $db->query(
+                'UPDATE keys_code
+                    SET expired_date = DATE_ADD(expired_date, INTERVAL ? SECOND)
+                  WHERE expired_date IS NOT NULL
+                    AND expired_date > ?',
+                [$seconds, $boundary]
+            );
+            $keys = $db->affectedRows();
+
+            if ($db->transStatus() === false) {
+                throw new \RuntimeException('the key update did not go through');
+            }
+
+            $db->transCommit();
+            self::$cache = [];
+
+            log_message('notice',
+                'Maintenance downtime of {s}s returned to {n} keys by {who}.',
+                ['s' => $seconds, 'n' => $keys, 'who' => $actor ?? 'unknown']);
+
+            $this->put(self::MAINTENANCE_CREDIT, $now . '|' . $seconds . '|' . $keys, $actor);
+
+            return ['seconds' => $seconds, 'keys' => $keys, 'clamped' => $clamped];
+        } catch (\Throwable $e) {
+            $db->transRollback();
+            log_message('critical',
+                'Could not return the maintenance downtime to the keys: {msg}',
+                ['msg' => $e->getMessage()]);
+
+            return null;
+        }
+    }
+
+    /**
+     * What the last turn-off gave back, or null if it never has.
+     *
+     * @return array{at:int,seconds:int,keys:int}|null
+     */
+    public static function lastCredit(): ?array
+    {
+        $raw = (string) self::get(self::MAINTENANCE_CREDIT, '');
+        $bits = explode('|', $raw);
+
+        if (count($bits) !== 3 || (int) $bits[0] <= 0) {
+            return null;
+        }
+
+        return ['at' => (int) $bits[0], 'seconds' => (int) $bits[1], 'keys' => (int) $bits[2]];
+    }
+
+    /** Who turned it on, and when. Null if it has never been set. */
+    public function maintenanceStamp(): ?object
+    {
+        try {
+            return $this->where('name', self::MAINTENANCE)->first();
+        } catch (\Throwable $e) {
+            return null;
+        }
+    }
+}
