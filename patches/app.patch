+<?php
+
+namespace App\Models;
+
+use CodeIgniter\Model;
+
+class GameModel extends Model
+{
+    protected $table      = 'games';
+    protected $primaryKey = 'id_game';
+
+    protected $allowedFields = ['code', 'name', 'status', 'sort_order'];
+    protected $useTimestamps = true;
+
+    // Objects, not arrays. CI4 defaults to arrays and the rest of this panel
+    // works in objects, so findAll() results would arrive in the wrong shape.
+    protected $returnType = 'object';
+
+    /**
+     * Games a seller may pick from, in display order.
+     *
+     * A game with no sellable duration is left out: offering it would only
+     * produce a "that duration is not available" error after the fact.
+     */
+    public function sellable(bool $isAdmin): array
+    {
+        $builder = $this->db->table('games g')
+            ->select('g.id_game, g.code, g.name')
+            ->join('game_durations d', 'd.game_id = g.id_game', 'inner')
+            ->where('g.status', 1)
+            ->where('d.status', 1);
+
+        if (! $isAdmin) {
+            $builder->where('d.admin_only', 0);
+        }
+
+        return $builder
+            ->groupBy('g.id_game, g.code, g.name, g.sort_order')
+            ->orderBy('g.sort_order', 'ASC')
+            ->orderBy('g.name', 'ASC')
+            ->get()->getResultObject();
+    }
+
+    /** Every game, active or not, for the admin screen. */
+    public function allOrdered(): array
+    {
+        return $this->orderBy('sort_order', 'ASC')
+            ->orderBy('name', 'ASC')
+            ->findAll();
+    }
+
+    public function byCode(string $code): ?object
+    {
+        return $this->where('code', $code)->first();
+    }
+
+    /**
+     * How many keys already reference this game code.
+     *
+     * The code is embedded in every key string, so renaming it would orphan
+     * them. The admin screen uses this to lock the field.
+     */
+    public function keyCount(string $code): int
+    {
+        return $this->db->table('keys_code')->where('game', $code)->countAllResults();
+    }
+}
