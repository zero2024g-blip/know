+<?php
+
+/**
+ * create_password
+ *
+ * @param  mixed $password
+ * @param  mixed $enc
+ * @return string
+ */
+function create_password($password, $enc = true)
+{
+    $optn = ['cost' => 8];
+    $patt = "X███████████████";
+    $hash = md5($patt . $password);
+    $pass = password_hash($hash, PASSWORD_DEFAULT, $optn);
+    return ($enc ? $pass : $hash);
+}
+
+function create_passwordV2(string $password): string 
+{
+    return password_hash($password, PASSWORD_ARGON2ID, [
+        'memory_cost' => 65536, 
+        'time_cost'   => 4,
+        'threads'     => 2
+    ]);
+}
+
+
+/**
+ * Display name for a user. Escapes, because every caller drops the
+ * result straight into a view with <?= ?>. Values are no longer stored
+ * pre-escaped, so escaping has to happen here at the output boundary.
+ */
+function getName($user)
+{
+    if (! $user) {
+        return '';
+    }
+    if ($user->fullname) {
+        return esc(word_limiter($user->fullname, 1, ''));
+    }
+    return esc($user->username);
+}
+
+function getLevel($level = 0)
+{
+    switch ($level) {
+        case '1':
+            $a = 'Admin';
+            break;
+        case '2':
+            $a = 'Reseller';
+            break;
+        default:
+            $a = 'Unknown';
+            break;
+    }
+    return $a;
+}
+
+function setMessage($msg, $color = 'secondary')
+{
+    return [$msg, $color];
+}
+
+function getDevice($devices)
+{
+    $total = 0;
+    $listDevice = "";
+    if ($devices) {
+        $clean_comma = reduce_multiples($devices, ",", true);
+        $ex = explode(',', $clean_comma);
+        $listDevice = "";
+        foreach ($ex as $ld) {
+            $listDevice .= "$ld\n";
+        }
+        $total = count($ex);
+    }
+    return (object) ['total' => $total, 'devices' => trim($listDevice)];
+}
+
+/**
+ * Turn the edit form's device box into the comma list the column stores.
+ *
+ * Anything that is not a device id is dropped: the box is one id per line,
+ * ids are [A-Za-z0-9-], and at most $max of them are kept.
+ *
+ * Returns NULL when nothing survives, which is what an empty box means --
+ * the key is released and every device may re-bind. That matters because
+ * a box holding only a stray space, or only punctuation, used to reach
+ * implode() with $result never assigned and threw a TypeError: the panel
+ * answered "Whoops!" and the save was lost.
+ */
+function setDevice($devicesPost, $max): ?string
+{
+    $max = max(1, (int) $max);
+
+    $ids = preg_replace('/[^A-Za-z0-9-]/', '', explode("\n", (string) $devicesPost));
+    $ids = array_filter(array_map('trim', $ids), static fn ($id) => $id !== '');
+    $ids = array_slice(array_unique($ids), 0, $max);
+
+    return $ids ? implode(',', $ids) : null;
+}
+
+/**
+ * Price for a key, or NULL when the duration is not one we sell.
+ *
+ * The old version read $price[$duration] blind. An unlisted duration gave
+ * an undefined index -> null -> null * devices = 0 -> `return false`, and
+ * the caller then computed `saldo - false * qty`, which is `saldo - 0`.
+ * A seller could post any duration they liked and be charged nothing.
+ *
+ * NULL is returned for "not for sale" so the caller must handle it
+ * explicitly; 0 and false both read as a legitimate free key.
+ */
+/**
+ * What one key costs: the tier's per-device price times the device count.
+ *
+ * Returns null rather than 0 for anything it cannot price. The two are very
+ * different here — 0 is a real price (the free test tier) and null means
+ * "refuse the sale". An earlier version returned false for an unlisted
+ * duration, which the caller read as free.
+ */
+function keyPrice(float $unitPrice, $device_max): ?float
+{
+    $device_max = (int) $device_max;
+
+    if ($device_max < 1 || $unitPrice < 0) {
+        return null;
+    }
+
+    return $unitPrice * $device_max;
+}
+
+/**
+ * Versioned URL for a file under public/.
+ *
+ * .htaccess serves CSS and JS with "max-age=31536000, immutable", which is
+ * what makes repeat visits cheap on a slow connection — but it also means a
+ * browser that already has the file will not re-check it for a year. Without
+ * a version in the URL, editing a stylesheet would reach new visitors only.
+ *
+ * The suffix is the file's modification time, so the URL changes exactly when
+ * the file does. A missing file falls back to the plain URL rather than
+ * throwing: a broken stylesheet link is better than a 500 on every page.
+ */
+function asset_ver(string $path): string
+{
+    $full = FCPATH . ltrim($path, '/');
+    $stamp = is_file($full) ? filemtime($full) : false;
+
+    return base_url($path) . ($stamp ? '?v=' . $stamp : '');
+}
diff -ruN /tmp/orig_app/Models/BalanceModel.php app/Models/BalanceModel.php
--- /tmp/orig_app/Models/BalanceModel.php	1970-01-01 00:00:00.000000000 +0000
+++ app/Models/BalanceModel.php	2026-08-26 19:53:55.233208010 +0000
@@ -0,0 +1,152 @@
+<?php
+
+namespace App\Models;
+
+use CodeIgniter\Model;
+
+/**
+ * The balance ledger.
+ *
+ * Append-only: rows are written when money moves and never edited after.
+ * `users.saldo` stays the working figure; this explains how it got there.
+ */
+class BalanceModel extends Model
+{
+    protected $table      = 'balance_log';
+    protected $primaryKey = 'id_log';
+
+    protected $allowedFields = ['user_id', 'delta', 'balance_after', 'reason', 'actor', 'note'];
+    protected $useTimestamps = true;
+    protected $returnType    = 'object';
+
+    public const TOPUP    = 'topup';
+    public const ADJUST   = 'adjustment';
+    public const PURCHASE = 'key_purchase';
+    public const REFERRAL = 'referral_signup';
+    public const OPENING  = 'opening';
+
+    /**
+     * Record one movement.
+     *
+     * Call inside the same transaction as the balance change itself, so the
+     * two either both land or neither does. A ledger that can disagree with
+     * the balance it describes is worse than no ledger.
+     *
+     * $balanceAfter is passed in rather than read back here: reading it would
+     * be a second query against a row another request may already have moved.
+     */
+    public function record(
+        int $userId,
+        float $delta,
+        float $balanceAfter,
+        string $reason,
+        ?string $actor = null,
+        ?string $note = null
+    ): void {
+        $this->insert([
+            'user_id'       => $userId,
+            'delta'         => $delta,
+            'balance_after' => $balanceAfter,
+            'reason'        => $reason,
+            'actor'         => $actor,
+            'note'          => $note !== null ? mb_substr($note, 0, 255) : null,
+        ]);
+    }
+
+    /** Most recent movements for one account. */
+    public function history(int $userId, int $limit = 50): array
+    {
+        return $this->where('user_id', $userId)
+            ->orderBy('id_log', 'DESC')
+            ->findAll($limit);
+    }
+
+    /**
+     * Totals for the account page.
+     *
+     * Credits and debits are summed separately rather than netted, because
+     * "you were topped up 400 and spent 250" says more than "net 150".
+     */
+    public function summary(int $userId): array
+    {
+        $row = $this->db->table($this->table)
+            ->select("
+                COALESCE(SUM(CASE WHEN delta > 0 AND reason <> 'opening' THEN delta END), 0) AS credited,
+                COALESCE(SUM(CASE WHEN reason = 'key_purchase' THEN -delta END), 0)          AS spent,
+                COALESCE(SUM(CASE WHEN reason = 'adjustment' THEN -delta END), 0)            AS deducted,
+                COALESCE(SUM(CASE WHEN reason = 'topup' THEN delta END), 0)                  AS topped_up,
+                COALESCE(SUM(CASE WHEN reason = 'topup' THEN 1 END), 0)                      AS topup_count,
+                MAX(CASE WHEN reason = 'topup' THEN created_at END)                          AS last_topup
+            ", false)
+            ->where('user_id', $userId)
+            ->get()->getRowObject();
+
+        return [
+            'credited'    => (float) ($row->credited ?? 0),
+            // Only real purchases. Summing every negative movement would fold
+            // an admin's manual reduction into "spent on keys", which is a
+            // different thing and made the figure read high.
+            'spent'       => (float) ($row->spent ?? 0),
+            'deducted'    => (float) ($row->deducted ?? 0),
+            'topped_up'   => (float) ($row->topped_up ?? 0),
+            'topup_count' => (int)   ($row->topup_count ?? 0),
+            'last_topup'  => $row->last_topup ?? null,
+        ];
+    }
+
+    /**
+     * Every account's movements, newest first. Admin screen only.
+     *
+     * The username is joined in rather than stored on the row: an account
+     * that gets renamed should not leave a ledger full of its old name.
+     * `actor` is the opposite case - it is a snapshot of who acted, kept as
+     * written, because the record of who did a thing must not change when
+     * that person is renamed or removed.
+     */
+    public function allHistory(int $limit = 200, ?string $reason = null): array
+    {
+        $builder = $this->db->table($this->table . ' b')
+            ->select('b.*, u.username, u.level', false)
+            ->join('users u', 'u.id_users = b.user_id', 'left');
+
+        if ($reason !== null && $reason !== '') {
+            $builder->where('b.reason', $reason);
+        }
+
+        return $builder->orderBy('b.id_log', 'DESC')
+            ->limit($limit)
+            ->get()->getResultObject();
+    }
+
+    /** Totals across every account, for the header of that screen. */
+    public function globalTotals(): array
+    {
+        $row = $this->db->table($this->table)
+            ->select("
+                COALESCE(SUM(CASE WHEN reason = 'topup' THEN delta END), 0)      AS topped_up,
+                COALESCE(SUM(CASE WHEN reason = 'topup' THEN 1 END), 0)          AS topup_count,
+                COALESCE(SUM(CASE WHEN reason = 'key_purchase' THEN -delta END), 0) AS spent,
+                COUNT(*)                                                         AS movements
+            ", false)
+            ->get()->getRowObject();
+
+        return [
+            'topped_up'   => (float) ($row->topped_up ?? 0),
+            'topup_count' => (int)   ($row->topup_count ?? 0),
+            'spent'       => (float) ($row->spent ?? 0),
+            'movements'   => (int)   ($row->movements ?? 0),
+        ];
+    }
+
+    /** Who has topped this account up, and how much in total. */
+    public function topUpSources(int $userId): array
+    {
+        return $this->db->table($this->table)
+            ->select('actor, COUNT(*) AS times, SUM(delta) AS total, MAX(created_at) AS last_at', false)
+            ->where('user_id', $userId)
+            ->where('reason', self::TOPUP)
+            ->groupBy('actor')
+            ->orderBy('total', 'DESC')
+            ->get()->getResultObject();
+    }
+}
