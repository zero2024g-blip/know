diff -ruN /tmp/orig_app/Config/WorkerMode.php app/Config/WorkerMode.php
--- /tmp/orig_app/Config/WorkerMode.php	1970-01-01 00:00:00.000000000 +0000
+++ app/Config/WorkerMode.php	2026-08-27 01:07:38.543266536 +0000
@@ -0,0 +1,62 @@
+<?php
+
+namespace Config;
+
+/**
+ * This configuration controls how CodeIgniter behaves when running
+ * in worker mode (with FrankenPHP).
+ */
+class WorkerMode
+{
+    /**
+     * Persistent Services
+     *
+     * List of service names that should persist across requests.
+     * These services will NOT be reset between requests.
+     *
+     * Services not in this list will be reset for each request to prevent
+     * state leakage.
+     *
+     * Recommended persistent services:
+     * - `autoloader`: PSR-4 autoloading configuration
+     * - `locator`: File locator
+     * - `exceptions`: Exception handler
+     * - `commands`: CLI commands registry
+     * - `codeigniter`: Main application instance
+     * - `superglobals`: Superglobals wrapper
+     * - `routes`: Router configuration
+     * - `cache`: Cache instance
+     *
+     * @var list<string>
+     */
+    public array $persistentServices = [
+        'autoloader',
+        'locator',
+        'exceptions',
+        'commands',
+        'codeigniter',
+        'superglobals',
+        'routes',
+        'cache',
+    ];
+
+    /**
+     * Reset Event Listeners
+     *
+     * List of event names whose listeners should be removed between requests.
+     * Use this if you register event listeners inside other event callbacks
+     * (rather than at the top level of Config/Events.php), which would cause
+     * them to accumulate across requests in worker mode.
+     *
+     * @var list<string>
+     */
+    public array $resetEventListeners = [];
+
+    /**
+     * Force Garbage Collection
+     *
+     * Whether to force garbage collection after each request.
+     * Helps prevent memory leaks at a small performance cost.
+     */
+    public bool $forceGarbageCollection = true;
+}
diff -ruN /tmp/orig_app/Controllers/Account.php app/Controllers/Account.php
--- /tmp/orig_app/Controllers/Account.php	1970-01-01 00:00:00.000000000 +0000
+++ app/Controllers/Account.php	2026-08-27 23:49:52.564921677 +0000
@@ -0,0 +1,126 @@
+<?php
+
+namespace App\Controllers;
+
+use App\Models\BalanceModel;
+use App\Models\KeysModel;
+use App\Models\UserModel;
+
+/**
+ * A seller's own account page: what they have sold, what they have spent,
+ * and every movement on their balance.
+ *
+ * An admin can open anyone's with /account/{id}. A seller can only ever see
+ * their own — the id is ignored for them rather than rejected, so there is
+ * nothing to probe: /account/1 and /account/999 both show a seller their own
+ * page, and neither confirms whether that account exists.
+ */
+class Account extends BaseController
+{
+    protected $users, $keys, $balance, $me;
+
+    public function __construct()
+    {
+        $this->users   = new UserModel();
+        $this->keys    = new KeysModel();
+        $this->balance = new BalanceModel();
+        $this->me      = $this->users->getUser();
+    }
+
+    public function index($id = null)
+    {
+        if (! $this->me) {
+            return redirect()->to('login');
+        }
+
+        $isAdmin = (int) $this->me->level === 1;
+
+        // Only an admin may look at someone else's.
+        $target = $this->me;
+        if ($isAdmin && $id !== null) {
+            $found = $this->users->getUser((int) $id);
+            if (! $found) {
+                return redirect()->to('admin/manage-users')
+                    ->with('msgDanger', 'That user no longer exists.');
+            }
+            $target = $found;
+        }
+
+        $uid      = (int) $target->id_users;
+        $username = $target->username;
+
+        $keyStats = $this->keys->stats($target);
+        // Scoped by the target's immutable id, so a re-used username never
+        // pulls a previous holder's keys into these figures.
+        $byGame   = $this->keys->byGameFor($uid);
+        $daily    = $this->keys->dailyFor($uid, 14);
+
+        // Fill the gaps so the sparkline has one column per day rather than
+        // only the days something happened.
+        $series = [];
+        $counts = [];
+        foreach ($daily as $d) {
+            $counts[$d->day] = (int) $d->n;
+        }
+        for ($i = 13; $i >= 0; $i--) {
+            $day = date('Y-m-d', strtotime("-{$i} days"));
+            $series[] = ['day' => $day, 'n' => $counts[$day] ?? 0];
+        }
+
+        return view('User/account', [
+            'title'     => $target === $this->me ? 'My account' : 'Account — ' . $username,
+            'user'      => $this->me,
+            'target'    => $target,
+            'isSelf'    => $uid === (int) $this->me->id_users,
+            'isAdmin'   => $isAdmin,
+            'time'      => new \CodeIgniter\I18n\Time(),
+            'keyStats'  => $keyStats,
+            'byGame'    => $byGame,
+            'series'    => $series,
+            'summary'   => $this->balance->summary($uid),
+            'ledger'    => $this->balance->history($uid, 50),
+            'topUps'    => $this->balance->topUpSources($uid),
+        ]);
+    }
+
+    /**
+     * Every account's balance movements, in one list. Admins only.
+     *
+     * A seller has no route to this: their own page already shows their own
+     * ledger and who topped them up, which is the whole of what concerns
+     * them. The level check is repeated here rather than left to the route
+     * group, so moving the route cannot quietly open it.
+     */
+    public function ledger()
+    {
+        if (! $this->me || (int) $this->me->level !== 1) {
+            return redirect()->to('dashboard')->with('msgWarning', 'Access Denied!');
+        }
+
+        // One optional filter, validated against the reasons that exist.
+        // Anything else is treated as no filter rather than as an error.
+        //
+        // getGet() returns whatever the query string held, and ?reason[]=a
+        // makes that an array - casting one to string is a PHP warning, and
+        // a warning is a 500 with the framework's error handler on.
+        $reason = $this->request->getGet('reason');
+        $reason = is_string($reason) ? $reason : '';
+        $known  = [
+            BalanceModel::TOPUP, BalanceModel::ADJUST, BalanceModel::PURCHASE,
+            BalanceModel::REFERRAL, BalanceModel::OPENING,
+        ];
+        if (! in_array($reason, $known, true)) {
+            $reason = '';
+        }
+
+        return view('Admin/balance_history', [
+            'title'  => 'Balance history',
+            'user'   => $this->me,
+            'time'   => new \CodeIgniter\I18n\Time(),
+            'rows'   => $this->balance->allHistory(200, $reason ?: null),
+            'totals' => $this->balance->globalTotals(),
+            'reason' => $reason,
+            'known'  => $known,
+        ]);
+    }
+}
