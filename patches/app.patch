+<?php
+
+namespace App\Filters;
+
+use App\Models\UserModel;
+use CodeIgniter\HTTP\RequestInterface;
+use CodeIgniter\HTTP\ResponseInterface;
+use CodeIgniter\Filters\FilterInterface;
+
+class AdminFilter implements FilterInterface
+{
+    public function before(RequestInterface $request, $arguments = null)
+    {
+        $session = session();
+
+        // Deny by default. Previously this only denied from inside a nested
+        // if, so any path that skipped those checks - no session, or a user
+        // row deleted mid-session - returned null and was ALLOWED.
+        $user = null;
+        if ($session->userid && $session->time_login) {
+            $user = (new UserModel())->getUser($session->userid);
+        }
+
+        if (! $user || (int) $user->level !== 1) {
+            return redirect()->to('dashboard')->with('msgWarning', "Access Denied!");
+        }
+
+        // Only a confirmed admin reaches this point.
+    }
+
+    public function after(RequestInterface $request, ResponseInterface $response, $arguments = null)
+    {
+        // Do something here
+    }
+}
