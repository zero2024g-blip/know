+<script>
+    (function () {
+        var gameModal = document.getElementById('gameModal');
+        var tierModal = document.getElementById('tierModal');
+
+        function open(dlg)  { dlg.showModal(); }
+        function close(dlg) { dlg.close(); }
+
+        document.querySelectorAll('[data-close]').forEach(function (b) {
+            b.addEventListener('click', function () { close(b.closest('dialog')); });
+        });
+
+        // ---- game dialog ----
+        function fillGame(d) {
+            document.getElementById('g_id').value     = d.id     || '';
+            document.getElementById('g_code').value   = d.code   || '';
+            document.getElementById('g_name').value   = d.name   || '';
+            document.getElementById('g_status').value = d.status !== undefined ? d.status : '1';
+            document.getElementById('g_sort').value   = d.sort   || 0;
+            document.getElementById('g_title').textContent = d.id ? 'Edit game' : 'Add game';
+
+            // Once keys exist the code is baked into them, so it stops being
+            // editable. Disabled inputs are not submitted, hence readonly.
+            var code = document.getElementById('g_code');
+            var hint = document.getElementById('g_code_hint');
+            if (d.locked === '1') {
+                code.setAttribute('readonly', 'readonly');
+                hint.textContent = 'Locked: keys already carry this code, so changing it would orphan them.';
+            } else {
+                code.removeAttribute('readonly');
+                hint.innerHTML = 'Letters and numbers only. It goes inside every key this game issues, like <code>CODM_a1b2c3</code>.';
+            }
+        }
+
+        document.querySelectorAll('[data-game-new]').forEach(function (b) {
+            b.addEventListener('click', function () { fillGame({}); open(gameModal); });
+        });
+        document.querySelectorAll('[data-game-edit]').forEach(function (b) {
+            b.addEventListener('click', function () {
+                fillGame({
+                    id: b.dataset.id, code: b.dataset.code, name: b.dataset.name,
+                    status: b.dataset.status, sort: b.dataset.sort, locked: b.dataset.locked
+                });
+                open(gameModal);
+            });
+        });
+
+        // ---- tier dialog ----
+        function fillTier(d) {
+            document.getElementById('t_id').value     = d.id     || '';
+            document.getElementById('t_game').value   = d.game   || '';
+            document.getElementById('t_hours').value  = d.hours  || '';
+            document.getElementById('t_label').value  = d.label  || '';
+            document.getElementById('t_price').value  = d.price  || '';
+            document.getElementById('t_admin').value  = d.adminonly !== undefined ? d.adminonly : '0';
+            document.getElementById('t_status').value = d.status !== undefined ? d.status : '1';
+            document.getElementById('t_sort').value   = d.sort   || 0;
+            document.getElementById('t_preset').value = '';
+            document.getElementById('t_title').textContent =
+                (d.id ? 'Edit tier — ' : 'Add tier to ') + (d.gamename || '');
+        }
+
+        document.querySelectorAll('[data-tier-new]').forEach(function (b) {
+            b.addEventListener('click', function () {
+                fillTier({ game: b.dataset.game, gamename: b.dataset.gamename });
+                open(tierModal);
+            });
+        });
+        document.querySelectorAll('[data-tier-edit]').forEach(function (b) {
+            b.addEventListener('click', function () { fillTier(b.dataset); open(tierModal); });
+        });
+
+        document.getElementById('t_preset').addEventListener('change', function () {
+            if (!this.value) return;
+            var parts = this.value.split('|');
+            document.getElementById('t_hours').value = parts[0];
+            document.getElementById('t_label').value = parts[1];
+        });
+
+        // ---- deletes ask first ----
+        document.querySelectorAll('form[data-confirm-delete]').forEach(function (f) {
+            f.addEventListener('submit', function (e) {
+                if (f.dataset.confirmed === '1') return;
+                e.preventDefault();
+                Swal.fire({
+                    title: 'Delete "' + f.dataset.confirmDelete + '"?',
+                    text: 'This cannot be undone.',
+                    icon: 'warning',
+                    showCancelButton: true,
+                    confirmButtonText: 'Yes, delete',
+                    confirmButtonColor: '#f4725a',
+                    cancelButtonColor: '#332420'
+                }).then(function (r) {
+                    if (r.isConfirmed) { f.dataset.confirmed = '1'; f.submit(); }
+                });
+            });
+        });
+    })();
+</script>
+<?= $this->endSection() ?>
