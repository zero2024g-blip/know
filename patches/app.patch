+<?php
+
+/**
+ * create_password
+ *
+ * @param  mixed $password
+ * @param  mixed $enc
+ * @return string
+ */
+function create_password($password, $enc = true)
+{
+    $optn = ['cost' => 8];
+    $patt = "X███████████████";
+    $hash = md5($patt . $password);
+    $pass = password_hash($hash, PASSWORD_DEFAULT, $optn);
+    return ($enc ? $pass : $hash);
+}
+
+function create_passwordV2(string $password): string 
+{
+    return password_hash($password, PASSWORD_ARGON2ID, [
+        'memory_cost' => 65536, 
+        'time_cost'   => 4,
+        'threads'     => 2
+    ]);
+}
+
+
+/**
+ * Display name for a user. Escapes, because every caller drops the
+ * result straight into a view with <?= ?>. Values are no longer stored
+ * pre-escaped, so escaping has to happen here at the output boundary.
+ */
+function getName($user)
+{
+    if (! $user) {
+        return '';
+    }
+    if ($user->fullname) {
+        return esc(word_limiter($user->fullname, 1, ''));
+    }
+    return esc($user->username);
+}
+
+function getLevel($level = 0)
+{
+    switch ($level) {
+        case '1':
+            $a = 'Admin';
+            break;
+        case '2':
+            $a = 'Reseller';
+            break;
+        default:
+            $a = 'Unknown';
+            break;
+    }
+    return $a;
+}
+
+function setMessage($msg, $color = 'secondary')
+{
+    return [$msg, $color];
+}
+
+function getDevice($devices)
+{
+    $total = 0;
+    $listDevice = "";
+    if ($devices) {
+        $clean_comma = reduce_multiples($devices, ",", true);
+        $ex = explode(',', $clean_comma);
+        $listDevice = "";
+        foreach ($ex as $ld) {
+            $listDevice .= "$ld\n";
+        }
+        $total = count($ex);
+    }
+    return (object) ['total' => $total, 'devices' => trim($listDevice)];
+}
+
+function setDevice($devicesPost, $max)
+{
+    // dont touch this forever please -_-
+    if ($devicesPost) {
+        $clean_enter = reduce_multiples($devicesPost, "\n", true);
+        $ez = [''];
+        $ef = array_unique(array_filter(preg_replace("/[^A-Za-z0-9-]/", "", explode("\n", $clean_enter))));
+        $ex = array_filter(array_merge($ez, $ef));
+        foreach ($ex as $k => $item) {
+            if ($k <= $max) {
+                $result[] = trim($item);
+            }
+        }
+        return implode(",", array_unique($result));
+    }
+}
+
+/**
+ * Price for a key, or NULL when the duration is not one we sell.
+ *
+ * The old version read $price[$duration] blind. An unlisted duration gave
+ * an undefined index -> null -> null * devices = 0 -> `return false`, and
+ * the caller then computed `saldo - false * qty`, which is `saldo - 0`.
+ * A seller could post any duration they liked and be charged nothing.
+ *
+ * NULL is returned for "not for sale" so the caller must handle it
+ * explicitly; 0 and false both read as a legitimate free key.
+ */
+/**
+ * What one key costs: the tier's per-device price times the device count.
+ *
+ * Returns null rather than 0 for anything it cannot price. The two are very
+ * different here — 0 is a real price (the free test tier) and null means
+ * "refuse the sale". An earlier version returned false for an unlisted
+ * duration, which the caller read as free.
+ */
+function keyPrice(float $unitPrice, $device_max): ?float
+{
+    $device_max = (int) $device_max;
+
+    if ($device_max < 1 || $unitPrice < 0) {
+        return null;
+    }
+
+    return $unitPrice * $device_max;
+}
+
+/**
+ * Versioned URL for a file under public/.
+ *
+ * .htaccess serves CSS and JS with "max-age=31536000, immutable", which is
+ * what makes repeat visits cheap on a slow connection — but it also means a
+ * browser that already has the file will not re-check it for a year. Without
+ * a version in the URL, editing a stylesheet would reach new visitors only.
+ *
+ * The suffix is the file's modification time, so the URL changes exactly when
+ * the file does. A missing file falls back to the plain URL rather than
+ * throwing: a broken stylesheet link is better than a 500 on every page.
+ */
+function asset_ver(string $path): string
+{
+    $full = FCPATH . ltrim($path, '/');
+    $stamp = is_file($full) ? filemtime($full) : false;
+
+    return base_url($path) . ($stamp ? '?v=' . $stamp : '');
+}
