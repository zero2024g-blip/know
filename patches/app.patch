--- /tmp/orig_app/Controllers/Maintenance.php	1970-01-01 00:00:00.000000000 +0000
+++ app/Controllers/Maintenance.php	2026-08-27 22:15:18.611057985 +0000
@@ -0,0 +1,171 @@
+<?php
+
+namespace App\Controllers;
+
+use App\Models\SettingModel;
+use App\Models\UserModel;
+
+/**
+ * The maintenance switch for the app connector.
+ *
+ * Admins only. A seller has no link to it and no way in: the level is
+ * re-checked in this controller as well as on the route group, because a
+ * route can be moved by accident and a method's own guard cannot.
+ */
+class Maintenance extends BaseController
+{
+    protected $settings, $me;
+
+    public function __construct()
+    {
+        $this->settings = new SettingModel();
+        $this->me       = (new UserModel())->getUser();
+    }
+
+    /** Refuse anyone who is not an admin. Returns a redirect, or null. */
+    private function denyNonAdmin()
+    {
+        if (! $this->me || (int) $this->me->level !== 1) {
+            return redirect()->to('dashboard')->with('msgWarning', 'Access Denied!');
+        }
+
+        return null;
+    }
+
+    public function index()
+    {
+        if ($stop = $this->denyNonAdmin()) {
+            return $stop;
+        }
+
+        return view('Admin/maintenance', [
+            'title'    => 'Maintenance',
+            'user'     => $this->me,
+            'time'     => new \CodeIgniter\I18n\Time(),
+            'isOn'     => SettingModel::maintenance(),
+            'message'  => SettingModel::maintenanceMessage(),
+            'stamp'    => $this->settings->maintenanceStamp(),
+            'default'  => SettingModel::DEFAULT_MESSAGE,
+            'since'    => (int) SettingModel::get(SettingModel::MAINTENANCE_SINCE, 0),
+            'credit'   => SettingModel::lastCredit(),
+        ]);
+    }
+
+    public function save()
+    {
+        if ($stop = $this->denyNonAdmin()) {
+            return $stop;
+        }
+
+        $on = $this->request->getPost('maintenance');
+        $on = is_scalar($on) && (string) $on === '1' ? '1' : '0';
+
+        // A form that carries no message field -- the one-click switch in the
+        // page banner -- must not wipe the message the admin typed here.
+        $raw = $this->request->getPost('message');
+        $msg = null;
+        if (is_scalar($raw)) {
+            // Bounded and single-line: this text is echoed back to every app
+            // that asks, and a newline in it would break a line-oriented client.
+            $msg = mb_substr(preg_replace('/\s+/u', ' ', trim((string) $raw)), 0, 160);
+        }
+
+        $was    = SettingModel::maintenance();
+        $credit = null;
+
+        try {
+            // Turning it ON: remember when, so the downtime can be given back.
+            // Only on the transition -- saving the page again while it is
+            // already on must not restart the clock.
+            if ($on === '1' && ! $was) {
+                $this->settings->put(SettingModel::MAINTENANCE_SINCE, (string) time(), $this->me->username);
+            }
+
+            // Turning it OFF: hand the downtime back to every key that was
+            // still running, BEFORE the apps start being served again, so no
+            // key is charged for the gap between the two writes.
+            if ($on === '0' && $was) {
+                $credit = $this->settings->creditDowntime($this->me->username);
+            }
+
+            $this->settings->put(SettingModel::MAINTENANCE, $on, $this->me->username);
+
+            if ($msg !== null) {
+                $this->settings->put(SettingModel::MAINTENANCE_MSG, $msg, $this->me->username);
+            }
+        } catch (\Throwable $e) {
+            log_message('error', 'Could not save the maintenance switch: {msg}',
+                ['msg' => $e->getMessage()]);
+
+            return redirect()->back()->with('msgDanger',
+                'Could not save. Nothing was changed.');
+        }
+
+        // Worth a log line of its own: this is the one setting that stops
+        // every app in the field, and "who turned it on" is the first
+        // question anyone asks afterwards.
+        log_message('notice', 'Maintenance switched {state} by {who}.',
+            ['state' => $on === '1' ? 'ON' : 'OFF', 'who' => $this->me->username]);
+
+        $flash = $on === '1'
+            ? 'Maintenance is ON. Apps will be refused until you turn it off.'
+            : 'Maintenance is OFF. Apps are being served again.';
+
+        if ($credit !== null) {
+            $flash .= ' ' . $this->humanSeconds($credit['seconds'])
+                . ' given back to ' . $credit['keys']
+                . ($credit['keys'] === 1 ? ' key' : ' keys') . '.';
+
+            if ($credit['clamped']) {
+                $flash .= ' (Capped at 30 days.)';
+            }
+        }
+
+        // The banner posts from whatever page the admin happened to be on, and
+        // sends it along so they land back there with the banner gone rather
+        // than being thrown to this screen.
+        $back = (string) $this->request->getPost('back');
+
+        if ($back !== '' && $this->isLocalPath($back)) {
+            return redirect()->to($back)->with('msgSuccess', $flash);
+        }
+
+        return redirect()->to('admin/maintenance')->with('msgSuccess', $flash);
+    }
+
+    /** "1h 4m", "45s" -- short enough to sit inside a flash message. */
+    private function humanSeconds(int $s): string
+    {
+        if ($s < 60) {
+            return $s . 's';
+        }
+
+        $d = intdiv($s, 86400);
+        $h = intdiv($s % 86400, 3600);
+        $m = intdiv($s % 3600, 60);
+
+        $bits = [];
+        if ($d) { $bits[] = $d . 'd'; }
+        if ($h) { $bits[] = $h . 'h'; }
+        if ($m && ! $d) { $bits[] = $m . 'm'; }
+
+        return implode(' ', $bits);
+    }
+
+    /**
+     * Is this a path on this panel, and nothing else?
+     *
+     * The return path comes from a form field, so it is only ever allowed to
+     * be a relative path of our own. Anything with a scheme, a host, or a
+     * backslash is dropped -- that is how an open redirect starts.
+     */
+    private function isLocalPath(string $path): bool
+    {
+        return $path !== ''
+            && $path[0] === '/'
+            && ! str_starts_with($path, '//')
+            && ! str_contains($path, '\\')
+            && ! preg_match('#^/*\w+:#', $path);
+    }
+
+}
