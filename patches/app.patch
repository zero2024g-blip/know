+<?php
+
+namespace App\Filters;
+
+use App\Models\LoginSessionModel;
+use App\Models\UserModel;
+use CodeIgniter\Filters\FilterInterface;
+use CodeIgniter\HTTP\RequestInterface;
+use CodeIgniter\HTTP\ResponseInterface;
+
+class AuthFilter implements FilterInterface
+{
+    public function before(RequestInterface $request, $arguments = null)
+    {
+        $session = session();
+
+        // Deny unless BOTH halves of the session are present. This was `and`
+        // between two truthiness checks, which let half a session through.
+        if (! $session->userid || ! $session->time_login) {
+            return redirect()->to('/login')->with('msgWarning', 'Please login first');
+        }
+
+        if ($stop = $this->rejectStolenSession($session)) {
+            return $stop;
+        }
+
+        return (new UserModel())->checkAuthFilter();
+    }
+
+    /**
+     * Refuse a session cookie being replayed from a different browser.
+     *
+     * A session cookie is a bearer token: hold it and you are treated as its
+     * owner. Copying the value out of one browser into another is enough to
+     * become that person — which is the attack, and it needs no password.
+     *
+     * So the cookie is no longer sufficient by itself. At sign-in the session
+     * was bound to a fingerprint of the browser that created it; here that
+     * fingerprint is recomputed and compared. A mismatch means the cookie is
+     * being presented by something other than the browser it was issued to,
+     * and the session is destroyed rather than merely refused — otherwise the
+     * thief could keep trying while the real owner stays signed in.
+     *
+     * Deliberately NOT bound to the IP address: on Iranian mobile networks it
+     * changes constantly, and a check that logs honest people out every few
+     * minutes gets turned off, which protects nobody.
+     */
+    private function rejectStolenSession($session)
+    {
+        $sessions = new LoginSessionModel();
+
+        try {
+            $row = $sessions->openSession(LoginSessionModel::currentId());
+        } catch (\Throwable $e) {
+            // The table is missing or unreachable. Let the request through —
+            // locking everyone out over a logging table would be worse — but
+            // say so loudly, because the protection is not running.
+            log_message('critical',
+                'login_sessions unavailable ({msg}). Session-theft protection is NOT active.',
+                ['msg' => $e->getMessage()]);
+            return null;
+        }
+
+        // No row: a session that predates this feature, or one already closed.
+        // Nothing to compare against, so nothing to reject.
+        if (! $row) {
+            return null;
+        }
+
+        if (! hash_equals($row->fingerprint, LoginSessionModel::fingerprint())) {
+            // 'error', not 'warning': the log threshold is 4, so a warning
+            // would be written nowhere and the one event an operator most
+            // wants to know about would leave no trace on disk.
+            log_message('error',
+                'Session fingerprint mismatch for user {u} — session destroyed. '
+                . 'A session cookie was presented by a different browser.',
+                ['u' => $row->username]);
+
+            $sessions->end(LoginSessionModel::currentId(), 'fingerprint');
+            $session->destroy();
+
+            return redirect()->to('/login')
+                ->with('msgDanger', 'Your session was ended for security. Please sign in again.');
+        }
+
+        $sessions->touch(LoginSessionModel::currentId());
+
+        return null;
+    }
+
+    public function after(RequestInterface $request, ResponseInterface $response, $arguments = null)
+    {
+        // Nothing to do after the response.
+    }
+}
