+<?php
+
+namespace App\Models;
+
+use CodeIgniter\Model;
+
+class DurationModel extends Model
+{
+    protected $table      = 'game_durations';
+    protected $primaryKey = 'id_duration';
+
+    protected $allowedFields = [
+        'game_id', 'hours', 'label', 'price', 'admin_only', 'status', 'sort_order',
+    ];
+    protected $useTimestamps = true;
+
+    // Objects, not arrays. CI4 defaults to arrays and the rest of this panel
+    // works in objects, so findAll() results would arrive in the wrong shape.
+    protected $returnType = 'object';
+
+    /** Tiers for one game, in display order. */
+    public function forGame(int $gameId, bool $activeOnly = true): array
+    {
+        if ($activeOnly) {
+            $this->where('status', 1);
+        }
+
+        return $this->where('game_id', $gameId)
+            ->orderBy('sort_order', 'ASC')
+            ->orderBy('hours', 'ASC')
+            ->findAll();
+    }
+
+    /**
+     * The whole catalogue as  code => [hours => tier]  for the generate page.
+     *
+     * $isAdmin decides whether admin-only tiers are included at all. They are
+     * filtered here, in one place, rather than in the view — a template change
+     * must not be able to put the free test key in a seller's dropdown.
+     */
+    public function catalogue(bool $isAdmin): array
+    {
+        $builder = $this->db->table('game_durations d')
+            ->select('g.code, d.hours, d.label, d.price, d.admin_only')
+            ->join('games g', 'g.id_game = d.game_id', 'inner')
+            ->where('d.status', 1)
+            ->where('g.status', 1);
+
+        if (! $isAdmin) {
+            $builder->where('d.admin_only', 0);
+        }
+
+        $rows = $builder->orderBy('g.sort_order', 'ASC')
+            ->orderBy('d.sort_order', 'ASC')
+            ->orderBy('d.hours', 'ASC')
+            ->get()->getResultObject();
+
+        $out = [];
+        foreach ($rows as $r) {
+            $out[$r->code][(int) $r->hours] = [
+                'label' => $r->label,
+                'price' => (float) $r->price,
+            ];
+        }
+
+        return $out;
+    }
+
+    /**
+     * The one tier a purchase is actually for, or null.
+     *
+     * Everything the price and the permission check depend on is resolved in
+     * this single query: the game must be active, the tier must belong to
+     * that game, be active, and be one this role may buy. A seller asking for
+     * an admin-only tier gets null, exactly like a tier that does not exist.
+     */
+    public function resolve(string $gameCode, int $hours, bool $isAdmin): ?object
+    {
+        $builder = $this->db->table('game_durations d')
+            ->select('d.id_duration, d.hours, d.label, d.price, d.admin_only, g.code, g.name')
+            ->join('games g', 'g.id_game = d.game_id', 'inner')
+            ->where('g.code', $gameCode)
+            ->where('g.status', 1)
+            ->where('d.hours', $hours)
+            ->where('d.status', 1);
+
+        if (! $isAdmin) {
+            $builder->where('d.admin_only', 0);
+        }
+
+        return $builder->get()->getRowObject();
+    }
+}
