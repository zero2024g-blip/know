diff -ruN /tmp/orig_app/Views/Layout/pager.php app/Views/Layout/pager.php
--- /tmp/orig_app/Views/Layout/pager.php	1970-01-01 00:00:00.000000000 +0000
+++ app/Views/Layout/pager.php	2026-08-27 00:08:43.056868758 +0000
@@ -0,0 +1,85 @@
+<?php
+/**
+ * Pager for a server-rendered list.
+ *
+ * Expects one $pager array:
+ *   param  query variable that carries the page number
+ *   page   the page being shown, 1-based
+ *   pages  how many pages there are
+ *   total  how many rows in the whole list
+ *   from   first row number on this page, 1-based
+ *   to     last row number on this page
+ *   per    rows per page
+ *   sizes  the page sizes on offer
+ *   size   query variable that carries the page size
+ *   keep   other query variables to carry through every link
+ *   anchor id to jump back to, so a page link lands on the table it moved
+ *
+ * There is no pager here when everything fits on one page — a row of
+ * controls that cannot do anything is just noise.
+ */
+$link = static function (array $set) use ($pager) {
+    $query = array_merge($pager['keep'], $set);
+    ksort($query);
+
+    return current_url() . '?' . http_build_query($query)
+        . ($pager['anchor'] ? '#' . $pager['anchor'] : '');
+};
+
+// First page, last page, and a window either side of the current one.
+// Anything else is an ellipsis: fifty numbered links is not navigation.
+$window = 1;
+$numbers = [];
+for ($n = 1; $n <= $pager['pages']; $n++) {
+    if ($n === 1 || $n === $pager['pages'] || abs($n - $pager['page']) <= $window) {
+        $numbers[] = $n;
+    } elseif (($numbers[count($numbers) - 1] ?? null) !== '…') {
+        $numbers[] = '…';
+    }
+}
+?>
+<div class="em-pager">
+    <div class="em-pager-count">
+        Showing <b><?= number_format($pager['from']) ?></b>–<b><?= number_format($pager['to']) ?></b>
+        of <b><?= number_format($pager['total']) ?></b>
+    </div>
+
+    <div class="em-pager-size">
+        <span>Show</span>
+        <?php foreach ($pager['sizes'] as $n) : ?>
+            <?php // Changing the page size lands you back on page 1: page 7 of
+                  // the old size is not page 7 of the new one. ?>
+            <a class="em-pagebtn<?= $n === $pager['per'] ? ' is-on' : '' ?>"
+               href="<?= esc($link([$pager['size'] => $n, $pager['param'] => 1]), 'attr') ?>"
+               <?= $n === $pager['per'] ? 'aria-current="true"' : '' ?>><?= $n ?></a>
+        <?php endforeach; ?>
+    </div>
+
+    <?php if ($pager['pages'] > 1) : ?>
+        <nav class="em-pager-nav" aria-label="Pages">
+            <?php if ($pager['page'] > 1) : ?>
+                <a class="em-pagebtn" href="<?= esc($link([$pager['param'] => $pager['page'] - 1]), 'attr') ?>"
+                   rel="prev">Previous</a>
+            <?php else : ?>
+                <span class="em-pagebtn is-off">Previous</span>
+            <?php endif; ?>
+
+            <?php foreach ($numbers as $n) : ?>
+                <?php if ($n === '…') : ?>
+                    <span class="em-pager-gap">…</span>
+                <?php elseif ($n === $pager['page']) : ?>
+                    <span class="em-pagebtn is-on" aria-current="page"><?= $n ?></span>
+                <?php else : ?>
+                    <a class="em-pagebtn" href="<?= esc($link([$pager['param'] => $n]), 'attr') ?>"><?= $n ?></a>
+                <?php endif; ?>
+            <?php endforeach; ?>
+
+            <?php if ($pager['page'] < $pager['pages']) : ?>
+                <a class="em-pagebtn" href="<?= esc($link([$pager['param'] => $pager['page'] + 1]), 'attr') ?>"
+                   rel="next">Next</a>
+            <?php else : ?>
+                <span class="em-pagebtn is-off">Next</span>
+            <?php endif; ?>
+        </nav>
+    <?php endif; ?>
+</div>
